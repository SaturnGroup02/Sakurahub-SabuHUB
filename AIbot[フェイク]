-- ===== 応答生成関数 =====
local function generateResponse(input)
    input = string.lower(input)
    input = string.gsub(input, "^%s+", "")
    input = string.gsub(input, "%s+$", "")
    
    -- 完全一致検索
    for pattern, response in pairs(responseDB) do
        if pattern == "default" then
            -- スキップ
        elseif string.find(input, pattern, 1, true) then
            return response
        end
    end
    
    -- 部分一致検索（より柔軟に）
    for pattern, response in pairs(responseDB) do
        if pattern == "default" then
            -- スキップ
        elseif string.find(input, pattern, 1, true) then
            return response
        end
    end
    
    -- デフォルト応答
    local defaultResponses = {
        "興味深い質問ですね！🤔 私はまだ学習中ですが、もっと色んなことを覚えていきます！",
        "その質問、考えたことがなかったです！🧠 勉強になります！",
        "素晴らしい質問ですね！🌟 私はまだ答えを知りませんが、調べてみます！",
        "なるほど！📝 その話題についてはもう少し勉強が必要みたいです。",
        "面白いですね！😮 私もそのことについてもっと知りたいです！"
    }
    return defaultResponses[math.random(1, #defaultResponses)]
end

-- ===== 思考時間計算 =====
local function calculateThinkTime(input)
    local baseTime = MIN_THINK_TIME
    local lengthFactor = math.min(#input / 50, 1.0) * 2.0
    local randomFactor = math.random() * 1.0
    local totalTime = baseTime + lengthFactor + randomFactor * 0.5
    return math.min(totalTime, MAX_THINK_TIME)
end

