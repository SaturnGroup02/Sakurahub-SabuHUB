local function CreateSlider(text, yPos, minVal, maxVal, defaultVal, callback)
    local baseY = yPos
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -10, 0, 18)
    lbl.Position = UDim2.new(0, 5, 0, baseY)
    lbl.BackgroundTransparency = 1
    lbl.Text = text .. ": " .. tostring(defaultVal)
    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    lbl.TextSize = 12
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = ScrollContainer

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0, 60, 0, 25)
    box.Position = UDim2.new(1, -70, 0, baseY - 2)
    box.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    box.TextColor3 = Color3.fromRGB(255, 20, 147)
    box.TextSize = 14
    box.Font = Enum.Font.GothamBold
    box.Text = tostring(defaultVal)
    box.BorderColor3 = Color3.fromRGB(255, 20, 147)
    box.BorderSizePixel = 2
    box.Parent = ScrollContainer

    box.FocusLost:Connect(function()
        local val = tonumber(box.Text)
        if val then
            local clamped = math.clamp(val, minVal, maxVal)
            box.Text = tostring(clamped)
            callback(clamped)
            lbl.Text = text .. ": " .. tostring(clamped)
        else
            box.Text = tostring(defaultVal)
        end
    end)
    return box
end

